<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(UseHistoricalContracts)' == 'true'">$(DefineConstants);AIKERNEL_HISTORICAL_CONTRACTS</DefineConstants>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AIKernel.Kernel" Version="[0.3.0]" />
    <PackageReference Include="AIKernel.Providers.LocalLlm" Version="[0.3.0]" />
  </ItemGroup>
</Project>
