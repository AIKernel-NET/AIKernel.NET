<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageVersion>0.3.0</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>aikernel-logo128x128.png</PackageIcon>
    <Description>AIKernel v1 provider placement descriptors, scoring, and worker pull contracts.</Description>
    <PackageReleaseNotes>Updates placement contracts to AIKernel 0.3.0, including chat generation and Vulkan targets.</PackageReleaseNotes>
    <PackageTags>aikernel;contracts;provider;placement</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AIKernel.Dtos" Version="[0.3.0]" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../aikernel-logo128x128.png" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
