<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageVersion>0.3.0</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>aikernel-logo128x128.png</PackageIcon>
    <Description>AIKernel embedding input, request, vector and capability contracts.</Description>
    <PackageReleaseNotes>First multimodal embedding request ABI, alongside the existing text embedding interfaces.</PackageReleaseNotes>
    <PackageTags>aikernel;contracts;embedding</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AIKernel.Abstractions" Version="[0.3.0]" />
    <PackageReference Include="AIKernel.Contracts.ProviderPlacement" Version="[0.3.0]" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../aikernel-logo128x128.png" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
