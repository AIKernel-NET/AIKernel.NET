<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AIKernel.Contracts.Images</PackageId>
    <Title>AIKernel Image Provider Contracts</Title>
    <PackageVersion>0.3.0</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>aikernel-logo128x128.png</PackageIcon>
    <PackageTags>aikernel;contracts;image;image-editing</PackageTags>
    <Description>Provider-neutral contracts for local image editing and visual tagging in AIKernel.</Description>
    <PackageReleaseNotes>Adds optional full-resolution matte refinement, edge contraction and color decontamination.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../aikernel-logo128x128.png" Pack="true" PackagePath="aikernel-logo128x128.png" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>
</Project>
